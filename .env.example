DATABASE_URL="file:../data/eat-it.db"
PORT=3000
APP_URL="https://eat-it.space"
# Email-based admin access requires a verified Google/Apple account.
ADMIN_EMAILS=""
# Explicitly trusted database user IDs for existing password administrators.
ADMIN_USER_IDS=""
# Enable only behind the local nginx proxy, which overwrites X-Real-IP.
TRUST_PROXY=false

# Recipe providers
SPOONACULAR_API_KEY=""
YANDEX_TRANSLATE_API_KEY=""

# Web Push
VAPID_SUBJECT="mailto:support@eat-it.space"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
